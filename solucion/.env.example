# =============================================================================
# Reto 03 · Configuración por variables de entorno
#
# Copia este archivo a `.env` y ajusta lo que necesites:
#     cp .env.example .env
# `.env` está ignorado por git; ESTE archivo sí se versiona porque es la
# documentación ejecutable de cómo se configura la aplicación.
#
# Ninguna de estas variables se registra ni se devuelve por la API (PRD §8):
# `/api/health` dice el proveedor y el modelo, nunca la clave.
# =============================================================================

# ── Proveedor de lenguaje (PRD §6.1) ──
# ollama = local y sin claves (por defecto) · openai = cualquier API compatible
# con OpenAI · mock = guion fijo sin modelo, para demos y pruebas.
LLM_PROVIDER=ollama

# ── Ollama local ──
OLLAMA_HOST=http://localhost:11434

# Modelo del ciclo del agente. Recomendado con 16 GB de RAM o más:
#     ollama pull granite4.1:8b      (5,3 GB · español + tool calling + JSON)
# Alternativa más liviana si andas escaso de memoria:
#     ollama pull qwen3:4b-instruct  (2,5 GB · tool calling, pero menos fiable
#                                     siguiendo instrucciones condicionales)
# Las cifras de esta elección están medidas en los retos 01 y 02 (mismo
# proveedor y mismo contrato de herramientas) y se re-miden aquí en F3.
OLLAMA_MODEL=granite4.1:8b

# Ventana de contexto. El prompt, el conocimiento del proceso y los esquemas de
# las seis herramientas pasan de 4 000 tokens, y el valor por defecto de Ollama
# es 4 096: por debajo de 8192 la petición falla con "request exceeds the
# available context size". Se ajusta al alza si la medición de F3 lo pide.
OLLAMA_NUM_CTX=8192

# Razonamiento previo de los modelos híbridos (`think`). Déjalo comentado salvo
# que el modelo razone: los modelos que no razonan rechazan el campo. Acepta
# true, false o el nivel low|medium|high|max.
# OLLAMA_THINK=false

# ── API compatible con OpenAI (solo si LLM_PROVIDER=openai) ──
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── Servidor HTTP ──
PORT=3000
HOST=127.0.0.1
# Correo de quien confirma en el chat (CA3). Es el que queda firmado en las
# excepciones del payload cuando la persona responde «sí»: sale de aquí y de la
# sesión, nunca del modelo.
USUARIO_ANALISTA=compras@periferia-ficticia.com

# ── Datos y reproducibilidad ──
# Solicitudes y maestros que entrega Periferia; vacío = ../fixtures/reto-03.
# El fixture NUNCA se escribe (PRD §7.1): solo se lee.
# FIXTURES_DIR=
# Salida del agente: la OC creada por el SAP simulado, la evidencia de
# aprobación, el log de control, log.jsonl y las sesiones. Vacío = ./out
# OUT_DIR=
# Fecha de referencia. Este PRD no fija una: se deja 2026-09-03 (la de los otros
# retos) para que las reglas que comparan fechas (RC8 retroactiva, RC9 orden de
# la aprobación) den el mismo resultado en la demo y en las pruebas.
# FECHA_EJECUCION=2026-09-03

# ── Reglas de control (PRD §7.3) ──
# RC5: diferencia máxima aceptada entre la cotización y la solicitud, en %.
TOLERANCIA_RC5_PCT=2
# RC10: tolerancia de cantidad × valor_unitario contra valor_total, en unidades
# monetarias (± 1).
TOLERANCIA_RC10_ABS=1
# Unidad de medida de la posición. El fixture no la trae: se deriva "H" cuando el
# texto habla de horas (bolsas de horas, servicios) y si no se usa este valor.
UNIDAD_DEFAULT=UN
# Límite de SAP en el texto breve de la posición, en caracteres. La descripción
# se recorta aquí y el recorte se informa en `excepciones`.
MAX_TEXTO_POSICION=40

# ── SAP simulado (PRD §7.4) ──
# simulado = escribe en out/sap/ · El adaptador real (OData/BAPI) es diseño, no
# implementación, y vive en SOLUCION.md §6.
SAP_MODO=simulado
# Constantes de sociedad y organización de compras del payload.
SAP_SOCIEDAD=1000
SAP_ORG_COMPRAS=1000
# Raíz del SAP simulado; vacío = <OUT_DIR>/sap
# SAP_RAIZ=

# ── Topes de gasto y robustez (PRD §8) ──
# Iteraciones herramienta → modelo por turno (CA1). Al alcanzarlas, el agente
# responde con lo que tiene y lo que le falta.
MAX_ITERACIONES=25
# Tope de tokens por sesión: un usuario no puede gastar la clave sin límite.
MAX_TOKENS_SESION=200000
# Timeout de la llamada al proveedor, en milisegundos (3 min). Al agotarse, el
# turno devuelve un error legible y la sesión sigue viva (CA5).
LLM_TIMEOUT_MS=180000
